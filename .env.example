# Copy to .env and fill in. .env is gitignored — never commit a real key.

# ---- Provider (§8 model gateway) ----------------------------------------
# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Everything below is optional; the defaults target Gemini's free tier.
#
# The gateway speaks the OpenAI dialect, so any compatible provider works —
# only these two lines change. Budget 2-3 model calls per user query, so
# requests-per-minute limits matter more than token limits.
#
#   Groq       https://api.groq.com/openai/v1          llama-3.3-70b-versatile
#   Cerebras   https://api.cerebras.ai/v1              llama-3.3-70b
#   OpenRouter https://openrouter.ai/api/v1            <model>:free
#   Ollama     http://localhost:11434/v1               llama3.1   (no key)
#
# FRIDAY_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Defaults to gemini-3.6-flash. Measured on the free tier: 2.5-flash is retired
# (404), while 3.7-flash and the gemini-flash-latest alias both hang past 45s.
# If this one is retired later, the 404 message names its replacement.
# FRIDAY_LLM_MODEL=gemini-3.6-flash

# Generic key name — wins over GEMINI_API_KEY. Use this when pointing at a
# provider that is not Gemini, so the variable name is not a lie.
# FRIDAY_LLM_API_KEY=

# ---- Service -------------------------------------------------------------
# Comma-separated CORS allowlist. Deliberately not a wildcard: any page on the
# machine could otherwise drive the agent.
# FRIDAY_ALLOWED_ORIGINS=http://localhost:3000
